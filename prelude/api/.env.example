# PRELUDE API environment
PORT=3000
DATABASE_URL=postgres://prelude:prelude@localhost:5432/prelude
JWT_SECRET=change-me-in-production
ML_SERVICE_URL=http://localhost:8000
# Any phone number listed here (comma separated) is treated as an admin
ADMIN_PHONE=+10000000000
# OTP is mocked; accept this code for any login (empty => accept any code)
MOCK_OTP=0000
# Per-user like cap per event (anti-spam)
SWIPE_LIMIT=100
